              "text/plain": {
                "examples": {
                  "Invalid Data": {
                    "value": 0
                  },
                  "Valid Data": {
                    "value": 1
                  }
                },
                "schema": {
                  "enum": [
                    1,
                    0
                  ],
                  "type": "integer"
                }
              }
            },
            "description": "\n* `1` - All data objects provided are valid. This does not signify a valid project token or secret.\n* `0` - One or more data objects in the body are invalid.\n"
          },
          "401": {
            "content": {
              "application/json": {
